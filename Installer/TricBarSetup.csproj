<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TricBarSetup</AssemblyName>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Company>Superplex</Company>
    <Copyright>Superplex</Copyright>
    <Version>1.1.0</Version>
    <TricBarWebSetup Condition="'$(TricBarWebSetup)' == ''">false</TricBarWebSetup>
    <SelfContained Condition="'$(TricBarWebSetup)' == 'true'">false</SelfContained>
    <SelfContained Condition="'$(TricBarWebSetup)' != 'true'">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AppBundleArchivePath Condition="'$(AppBundleArchivePath)' == ''">$(MSBuildThisFileDirectory)..\dist\TricBar-v2-LocalBundle.zip</AppBundleArchivePath>
    <DefineConstants Condition="'$(TricBarWebSetup)' == 'true'">$(DefineConstants);TRICBAR_WEB_SETUP</DefineConstants>
    <EnableCompressionInSingleFile Condition="'$(TricBarWebSetup)' != 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TricBarWebSetup)' != 'true'">
    <EmbeddedResource Include="$(AppBundleArchivePath)"
                      LogicalName="TricBarSetup.AppBundle.zip" />
  </ItemGroup>
</Project>
